rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().active == true; }
    function admin() { return active() && profile().role == "administrador"; }
    function allowed(module) {
      return active() && (profile().role == "administrador" || module in profile().permissions);
    }
    function firstAdminUser(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/settings/bootstrap)
        && request.resource.data.role == "administrador"
        && request.resource.data.active == true
        && getAfter(/databases/$(database)/documents/settings/bootstrap).data.adminUid == userId;
    }

    match /users/{userId} {
      allow read: if active() && (admin() || request.auth.uid == userId);
      allow create: if admin() || firstAdminUser(userId);
      allow update: if admin();
      allow delete: if false;
    }

    match /properties/{id} {
      allow read: if resource.data.published == true || allowed("properties");
      allow create, update, delete: if allowed("properties");
    }
    match /clients/{id} { allow read, write: if allowed("clients"); }
    match /leads/{id} {
      allow create: if true;
      allow read, update, delete: if allowed("leads");
    }
    match /events/{id} { allow read, write: if allowed("agenda"); }
    match /documents/{id} { allow read, write: if allowed("documents"); }
    match /finance/{id} { allow read, write: if allowed("finance"); }
    match /brokers/{id} { allow read, write: if allowed("brokers"); }
    match /services/{id} { allow read, write: if allowed("services"); }
    match /settings/bootstrap {
      allow read: if true;
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/settings/bootstrap)
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrador"
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
      allow update, delete: if false;
    }
    match /settings/{id} {
      allow read: if active();
      allow write: if admin() && id != "bootstrap";
    }
    match /{document=**} { allow read, write: if false; }
  }
}
