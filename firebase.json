{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "firestore.rules", "firestore.indexes.json", "storage.rules", "README-FIREBASE.md", "assets/*-v2.png"],
    "headers": [
      {
        "source": "/admin.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
